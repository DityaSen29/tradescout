  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "@types/node": "^26.6.6",
    "neo4j-driver": "^6.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
