{
  "name": "tradescout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TradeScout: an export sourcing desk. Product and market in; cited market signal, vetted counterparties with a trust tier, the right contact and an approval-gated draft out.",
  "scripts": {
